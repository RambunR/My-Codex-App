# Local development only. Production must use a fresh DATA_DIR and SEED_DEMO=false.
PORT=3000
APP_URL=http://localhost:3000
DATA_DIR=./data
PAYMENTS_MODE=demo
SEED_DEMO=true

# Indicative USD -> HKD rate for the minimum withdrawal check and estimate.
# Actual bank conversion and payout fees are determined by the payment provider.
USD_TO_HKD=7.8

# Live payments: PAYMENTS_MODE=stripe, HTTPS APP_URL, SEED_DEMO=false.
# Configure real values securely on your hosting provider. Never commit them.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Explicit Stripe test Checkout on this same site. Uses separate test balances,
# earnings, activation and purchases; no real money or payouts. False for live.
STRIPE_TEST_MODE=false
# Optional same-mode Stripe catalog IDs. Leave blank to use secure inline prices.
STRIPE_ACTIVATION_PRICE_ID=
STRIPE_WALLET_PRODUCT_ID=

# Optional Google OAuth (Web application client). Keep these server-side.
# Callback is APP_URL + /api/auth/google/callback; never commit real credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional Sign in with Apple Services ID and server-only .p8 signing key.
# Callback is APP_URL + /api/auth/apple/callback (HTTPS, Apple form_post).
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Optional transactional email. Verify a sending domain first.
# Cloudflare Email Sending requires Workers Paid + a domain using Cloudflare DNS.
# Use a narrow Email Sending: Edit token, never the broad deployment API token.
EMAIL_PROVIDER=auto
CF_EMAIL_ACCOUNT_ID=
CF_EMAIL_API_TOKEN=
# Alternatively select EMAIL_PROVIDER=resend for Resend delivery.
RESEND_API_KEY=
# Sender example: LingYing <auth@your-domain> (either provider).
MAIL_FROM=

# Optional private S3-compatible object storage (including Cloudflare R2).
# Leave all S3 fields empty to use local private storage under DATA_DIR/objects.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Set only when exactly one trusted reverse proxy sits in front of the app.
TRUST_PROXY=false

# Optional executable overrides.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
