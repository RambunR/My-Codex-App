{
  "name": "short-drama-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build && esbuild server/index.ts --bundle --platform=node --packages=external --format=esm --outfile=dist/server.js",
    "start": "NODE_ENV=production node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "seed": "tsx server/seed.ts",
    "admin:create": "tsx server/create-admin.ts",
    "test:production": "node scripts/smoke-production.mjs",
    "build:cloudflare": "node scripts/build-cloudflare.mjs && tsc --noEmit && tsc -p tsconfig.cloudflare.json && vite build",
    "dev:cloudflare": "XDG_CONFIG_HOME=/tmp/aidramio-cf-config WRANGLER_SEND_METRICS=false wrangler dev",
    "deploy:cloudflare": "node scripts/deploy-cloudflare.mjs",
    "admin:cloudflare": "node scripts/cloudflare-admin.mjs",
    "test:cloudflare": "node scripts/smoke-cloudflare.mjs",
    "stripe:catalog:test": "node scripts/provision-stripe-test.mjs",
    "stripe:connect:sandbox": "node scripts/connect-stripe-sandbox.mjs",
    "stripe:connect:test": "node scripts/connect-stripe-main-test.mjs",
    "deploy:sandbox": "CLOUDFLARE_ACCOUNT_ID=95040c4f244233138195b80657887486 XDG_CONFIG_HOME=/tmp/aidramio-cf-config WRANGLER_SEND_METRICS=false wrangler deploy --config wrangler.sandbox.jsonc --keep-vars"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1000.0",
    "@aws-sdk/s3-request-presigner": "^3.1000.0",
    "express": "^5.1.0",
    "jose": "^6.2.13",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "sharp": "^0.35.5",
    "stripe": "^20.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261025.1",
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "undici": "^7.30.1",
    "vite": "^7.1.0",
    "wrangler": "^4.152.0"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.9.0"
}
