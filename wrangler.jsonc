{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lingying",
  "main": "cloudflare/worker.ts",
  "account_id": "95040c4f244233138195b80657887486",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "APP",
        "class_name": "AIDramioApp"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "AIDramioApp"
      ]
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "aidramio-media-887486"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "PLATFORM_OWNER_USER_ID": "000ca929-30da-4e8b-a2a6-2135d184fe9b",
    "PLATFORM_ADMIN_EMAIL_SHA256": "cfc96d9ff6250477b7b34ea924d18d5fea9aeeee747a22c7af0b663a245d87b6",
    "OFFICIAL_CREATOR_NAME": "LingYingDrama Offical",
    "APP_URL": "https://lingyingdrama.com",
    "PAYMENTS_MODE": "stripe",
    "PASS_PROMOTION_ENABLED": "true",
    "STRIPE_ACTIVATION_PRICE_ID": "",
    "STRIPE_WALLET_PRODUCT_ID": "",
    "PAYOUTS_ENABLED": "false",
    "STRIPE_TEST_PAYOUTS_ENABLED": "true",
    "STRIPE_TEST_PAYOUT_ACCOUNT_ID": "acct_1UXy05J6ErvOVs1A",
    "STRIPE_AUTO_CONFIGURE_WEBHOOK": "true",
    "USD_TO_HKD": "7.8",
    "SEED_CATALOG": "false",
    "EMAIL_PROVIDER": "cloudflare",
    "CF_EMAIL_ACCOUNT_ID": "95040c4f244233138195b80657887486",
    "MAIL_FROM": "LingYing <accounts@hknovaxrproduction.com>",
    "PUBLIC_APP_URL": "https://lingyingdrama.com",
    "STRIPE_SITE_ORIGIN": "https://aidramio.jimmy-tsoi2001.workers.dev"
  },
  "observability": {
    "enabled": true
  },
  "build": {
    "command": "npm run build:cloudflare",
    "cwd": ".",
    "watch_dir": [
      "server",
      "shared",
      "cloudflare",
      "src",
      "public"
    ]
  },
  "routes": [
    {
      "pattern": "lingyingdrama.com",
      "custom_domain": true,
      "zone_id": "ae6b34326f28faf55a6c7179d57bcba7"
    },
    {
      "pattern": "www.lingyingdrama.com",
      "custom_domain": true,
      "zone_id": "ae6b34326f28faf55a6c7179d57bcba7"
    }
  ]
}
